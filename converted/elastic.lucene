(process.executable.caseless:*\\schtasks.exe OR process.pe.original_file_name:schtasks.exe) AND process.command_line:*\/create* AND (process.command_line:(*powershell* OR *pwsh* OR *cmd.exe\ \/c* OR *cmd\ \/c* OR *mshta* OR *wscript* OR *cscript* OR *rundll32* OR *regsvr32* OR *\\AppData\\* OR *\\Temp\\* OR *\\Users\\Public\\* OR *http\:\/\/* OR *https\:\/\/*))

